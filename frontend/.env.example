# ==========================================
# CMES-USER Frontend — Environment Variables
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# cp .env.example .env

# User Backend API
REACT_APP_API_BASE_URL=http://localhost:5002

# Admin Backend API (สำหรับ Socket.IO + realtime)
REACT_APP_ADMIN_API_URL=http://localhost:5001
REACT_APP_REALTIME_URL=http://localhost:5001

# Google OAuth (สร้างที่ https://console.cloud.google.com → Credentials → OAuth 2.0)
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
